# ── Database (required) ─────────────────────────────────────────────
# Railway sets this automatically when you add a PostgreSQL service and
# reference it from the app: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local development (Homebrew Postgres):
DATABASE_URL=postgres://localhost/justus_dev

# ── Photo & voice storage ──────────────────────────────────────────
# Leave these empty in development: files are stored on local disk (.data/uploads).
# Production: Cloudflare R2 (Dashboard → R2 → create bucket → Manage API tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── TURN relay for calls (recommended in production) ───────────────
# Cloudflare Realtime → TURN Server → Create. Without it, calls fall back to
# STUN only and may fail on some mobile networks.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Alternatives (use one): Metered, or your own coturn
# METERED_DOMAIN=yourapp.metered.live
# METERED_API_KEY=
# TURN_URLS=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=
